# Coverage configuration file
# https://coverage.readthedocs.io/en/latest/config.html

[run]
# Measure branch coverage in addition to statement coverage
branch = True

# Source code paths to measure
source = .

# Paths to omit from coverage measurement
omit =
    # Test files
    */tests/*
    */test_*.py
    *_test.py

    # Virtual environments
    */venv/*
    */env/*
    */.venv/*
    */virtualenv/*

    # Build and distribution
    */dist/*
    */build/*
    */eggs/*
    */*.egg-info/*

    # Documentation
    */docs/*

    # Generated files
    */__pycache__/*
    *.pyc

    # Scripts that aren't part of main codebase
    setup.py

    # Notebooks
    */notebooks/*
    *.ipynb

# Store coverage data in project root
data_file = .coverage

[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__
    def __str__

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:
    if __name__==.__main__.:

    # Don't complain about type checking code
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:

    # Don't complain about abstract methods
    @abstractmethod
    @abc.abstractmethod

    # Don't complain about verbose/debug branches
    if verbose:
    if debug:
    if self.verbose:
    if self.debug:

    # Don't complain about ellipsis in stubs
    \.\.\.

# Ignore errors for source code not found
ignore_errors = False

# Number of decimal places for coverage percentage
precision = 2

# Show lines that weren't executed
show_missing = True

# Don't show files with 100% coverage
skip_covered = False

# Sort report by coverage percentage
sort = Cover

[html]
# Directory for HTML report
directory = htmlcov

# Title for HTML report
title = GenX Analysis Coverage Report

[xml]
# Filename for XML report (for CI systems)
output = coverage.xml

[json]
# Filename for JSON report
output = coverage.json
# Pretty-print JSON
pretty_print = True
