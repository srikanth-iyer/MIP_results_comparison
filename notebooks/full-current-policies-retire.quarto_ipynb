    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Retirements\n",
        "\n",
        "## Row\n",
        "\n",
        "#### Column {.tabset}"
      ],
      "id": "ad5f4581"
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Retired Capacity"
      },
      "source": [
        "from fig_functions import calc_period_retirements, chart_retirements\n",
        "retire_cap = calc_period_retirements(cap, by_agg_zone=True, multi_case=False)\n",
        "chart = chart_retirements(retire_cap, col_var=\"tech_type\", x_var=\"model\")\n",
        "chart"
      ],
      "id": "0d51aba2",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Retired Regional Capacity"
      },
      "source": [
        "chart = chart_retirements(\n",
        "    retire_cap, col_var=\"tech_type\", x_var=\"model\", row_var=\"agg_zone\"\n",
        ")\n",
        "chart"
      ],
      "id": "836a1344",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Capacity Tables\n",
        "\n",
        "## Row\n",
        "\n",
        "#### Column {.tabset}"
      ],
      "id": "6077fd2d"
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Total Start Existing Capacity"
      },
      "source": [
        "ex_cap_sum = (\n",
        "    cap.query(\"existing==True and unit=='MW'\")\n",
        "    .groupby([\"model\", \"planning_year\", \"tech_type\"], as_index=False)[\"start_value\"]\n",
        "    .sum()\n",
        "    .pivot(columns=\"model\", index=[ \"tech_type\", \"planning_year\"])\n",
        "    .reset_index()\n",
        ")\n",
        "cols = ex_cap_sum.columns\n",
        "ex_cap_sum.columns = list(cols.get_level_values(0)[:2]) + list(\n",
        "    cols.get_level_values(1)[2:]\n",
        ")\n",
        "\n",
        "try:\n",
        "    display(Markdown(ex_cap_sum.to_markdown(index=False)))\n",
        "except:\n",
        "    pass"
      ],
      "id": "2815a835",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Total End Existing Capacity"
      },
      "source": [
        "ex_cap_sum = (\n",
        "    cap.query(\"existing==True and unit=='MW'\")\n",
        "    .groupby([\"model\", \"planning_year\", \"tech_type\"], as_index=False)[\"end_value\"]\n",
        "    .sum()\n",
        "    .pivot(columns=\"model\", index=[\"tech_type\", \"planning_year\"])\n",
        "    .reset_index()\n",
        ")\n",
        "cols = ex_cap_sum.columns\n",
        "ex_cap_sum.columns = list(cols.get_level_values(0)[:2]) + list(\n",
        "    cols.get_level_values(1)[2:]\n",
        ")\n",
        "\n",
        "try:\n",
        "    display(Markdown(ex_cap_sum.to_markdown(index=False)))\n",
        "except:\n",
        "    pass"
      ],
      "id": "ab2083aa",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Regional End Existing Capacity"
      },
      "source": [
        "ex_reg_cap_sum = (\n",
        "    cap.query(\"existing==True and unit=='MW'\")\n",
        "    .groupby(\n",
        "        [\"agg_zone\", \"model\", \"planning_year\", \"tech_type\", \"resource_name\"],\n",
        "        as_index=False,\n",
        "    )[\"end_value\"]\n",
        "    .sum()\n",
        "    .pivot(\n",
        "        columns=\"model\",\n",
        "        index=[\"agg_zone\", \"tech_type\", \"resource_name\", \"planning_year\"],\n",
        "    )\n",
        "    .fillna(0)\n",
        "    .reset_index()\n",
        ")\n",
        "cols = ex_reg_cap_sum.columns\n",
        "ex_reg_cap_sum.columns = list(cols.get_level_values(0)[:4]) + list(\n",
        "    cols.get_level_values(1)[4:]\n",
        ")\n",
        "from itables import init_notebook_mode\n",
        "\n",
        "init_notebook_mode(all_interactive=True, connected=True)\n",
        "ex_reg_cap_sum"
      ],
      "id": "779d5c75",
      "execution_count": null,
      "outputs": []
    },
