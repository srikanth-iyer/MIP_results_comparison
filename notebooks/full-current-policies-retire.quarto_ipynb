    {
      "cell_type": "code",
      "metadata": {
        "title": "2030 Dispatch"
      },
      "source": [
        "data = dispatch.query(\"planning_year==2030\").groupby([\"model\", \"tech_type\", \"agg_zone\", \"hour\"], as_index=False)[\n",
        "    \"value\"\n",
        "].sum()\n",
        "chart = chart_dispatch(data)\n",
        "chart"
      ],
      "id": "a984f164",
      "execution_count": null,
      "outputs": []
    },
