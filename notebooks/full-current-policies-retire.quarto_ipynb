    {
      "cell_type": "code",
      "metadata": {
        "title": "Generation"
      },
      "source": [
        "if not op_gen_cap.empty:\n",
        "    op_gen_cap = op_gen_cap.query(\n",
        "        \"~tech_type.str.contains('Other')\"\n",
        "    )\n",
        "    op_gen = op_gen_cap[\n",
        "        [\"tech_type\", \"planning_year\", \"model\", \"AnnualSum\", \"resource_name\"]\n",
        "    ].rename(columns={\"AnnualSum\": \"value\"})\n",
        "    op_cap = op_gen_cap[\n",
        "        [\"tech_type\", \"planning_year\", \"model\", \"Capacity\", \"resource_name\"]\n",
        "    ].rename(columns={\"Capacity\": \"end_value\"})\n",
        "    op_cap[\"unit\"] = \"MW\"\n",
        "\n",
        "\n",
        "    chart = chart_total_gen(op_gen, op_cap)\n",
        "    chart"
      ],
