   "source": [
    "---\n",
    "title: \"only-genx\"\n",
    "format: dashboard\n",
    "#   dashboard:\n",
    "#     scrolling: false\n",
    "jupyter: python3\n",
    "categories:\n",
    "    - 20-week\n",
    "    - Net-zero\n",
    "    - Foresight\n",
    "---\n"
   ]
  },
