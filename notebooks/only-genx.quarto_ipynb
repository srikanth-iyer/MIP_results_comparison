   "source": [
    "from fig_functions_genx_only import chart_cap_factor_scatter\n",
    "\n",
    "chart = chart_cap_factor_scatter(\n",
    "    cap.query(\"tech_type=='Solar'\"),\n",
    "    gen.query(\"tech_type=='Solar'\"),\n",
    "    # # dispatch.query(\"tech_type=='Solar'\"),\n",
    "    col_var=\"planning_year\",\n",
    "    # frac=0.5,\n",
    ")\n",
    "chart"
   ]
  },
