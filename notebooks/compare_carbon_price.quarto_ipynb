      "source": [
        "# Emissions"
      ],
      "id": "011738cf"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "chart = chart_emissions(emiss, x_var=\"model\", col_var=\"case\", order=order)\n",
        "chart"
      ],
      "id": "462b3cb8",
      "execution_count": null,
