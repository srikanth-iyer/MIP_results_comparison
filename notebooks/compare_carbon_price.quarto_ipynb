    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Transmission\n",
        "## Row\n",
        "\n",
        "#### Column {.tabset}"
      ],
      "id": "82b81a83"
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Expansion by line"
      },
      "source": [
        "tx_all = pd.concat([starting_tx, tx_exp])\n",
        "chart = chart_tx_expansion(\n",
        "    tx_all,\n",
        "    x_var=\"case\",\n",
        "    facet_col=None,\n",
        "    col_var=\"line_name\",\n",
        "    row_var=\"model\",\n",
        "    order=order,\n",
        ")\n",
        "chart"
      ],
      "id": "dd005160",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Total expansion"
      },
      "source": [
        "chart = chart_tx_expansion(\n",
        "    tx_all, x_var=\"case\", facet_col=None, col_var=\"model\", order=order\n",
        ")\n",
        "# chart = chart_tx_expansion(\n",
        "#     tx_all, x_var=\"model\", facet_col=None, col_var=\"case\", order=order\n",
        "# )\n",
        "chart"
      ],
      "id": "79e05b16",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Map by case"
      },
      "source": [
        "tx_exp_data = (\n",
        "    tx_exp.groupby(\n",
        "        [\"line_name\", \"planning_year\", \"case\", \"start_region\", \"dest_region\"],\n",
        "        as_index=False,\n",
        "    )[\"value\"]\n",
        "    .mean()\n",
        "    .sort_values(\"case\")\n",
        ")\n",
        "\n",
        "chart = chart_tx_map(\n",
        "    tx_exp_data,\n",
        "    gdf,\n",
        "    facet_col=\"case\",\n",
        ")\n",
        "chart"
      ],
      "id": "61fed21f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Map by case, drop lines < 50 MW"
      },
      "source": [
        "tx_exp_data = (\n",
        "    tx_exp.groupby(\n",
        "        [\"line_name\", \"planning_year\", \"case\", \"start_region\", \"dest_region\"],\n",
        "        as_index=False,\n",
        "    )[\"value\"]\n",
        "    .mean()\n",
        "    .query(\"value >= 50\").sort_values(\"case\")\n",
        ")\n",
        "\n",
        "chart = chart_tx_map(\n",
        "    tx_exp_data,\n",
        "    gdf,\n",
        "    facet_col=\"case\",\n",
        ")\n",
        "chart"
      ],
      "id": "38c62754",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Operational Results\n",
        "## Row {.tabset}"
      ],
      "id": "58e6fa7b"
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Operational costs (model)"
      },
      "source": [
        "chart = chart_op_cost(\n",
        "    op_costs_model, col_var=\"case\", x_var=\"model\", row_var=\"planning_year\", order=order\n",
        ")\n",
        "chart"
      ],
      "id": "76bbb225",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Operational costs (society)"
      },
      "source": [
        "chart = chart_op_cost(\n",
        "    op_costs, col_var=\"case\", x_var=\"model\", row_var=\"planning_year\", order=order\n",
        ")\n",
        "chart"
      ],
      "id": "cdde26d2",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Generation"
      },
      "source": [
        "try:\n",
        "    chart = chart_total_gen(\n",
        "        op_gen,\n",
        "        op_cap,\n",
        "        col_var=\"case\",\n",
        "        x_var=\"model\",\n",
        "        row_var=\"planning_year\",\n",
        "        order=order,\n",
        "    )\n",
        "    chart\n",
        "except:\n",
        "    pass"
      ],
      "id": "8ef86e81",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Emissions by zone"
      },
      "source": [
        "chart = chart_emissions(\n",
        "    op_emiss,\n",
        "    col_var=\"case\",\n",
        "    x_var=\"model\",\n",
        "    # row_var=\"planning_year\",\n",
        "    # color=\"Region\",\n",
        "    order=order,\n",
        ")\n",
        "chart"
      ],
      "id": "cedb8de2",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "title": "Power cost"
      },
      "source": [
        "from fig_functions import chart_cost_mwh\n",
        "\n",
        "chart = chart_cost_mwh(\n",
        "    op_costs, col_var=\"case\", x_var=\"model\", row_var=\"planning_year\", order=order\n",
